+class LengthBucketSampler(torch.utils.data.Sampler):
+    """Batches of similar-length utterances, in a shuffled order.
+
+    Two things depend on it. The trainers slice their decoder segment with
+    `mel_len = min(mel_input_length.min() / 2 - 1, max_len // 2)`, so one short member drags
+    a whole batch's window down, and `Collater` pads every batch to its longest member. On a
+    corpus whose utterances span 1 to 14 seconds a random draw pays both costs on every step.
+
+    The audio is not read to measure it: the phoneme string is the length proxy, and it is
+    already in the filelist.
+    """
+
+    def __init__(self, lengths, batch_size, shuffle=True, drop_last=True, seed=0):
+        self.batch_size = int(batch_size)
+        self.shuffle = shuffle
+        self.seed = int(seed)
+        self.epoch = 0
+        order = sorted(range(len(lengths)), key=lambda index: lengths[index])
+        self.batches = [
+            order[start : start + self.batch_size]
+            for start in range(0, len(order), self.batch_size)
+        ]
+        if drop_last:
+            self.batches = [batch for batch in self.batches if len(batch) == self.batch_size]
+
+    def set_epoch(self, epoch):
+        self.epoch = int(epoch)
+
+    def __len__(self):
+        return len(self.batches)
+
+    def __iter__(self):
+        batches = list(self.batches)
+        if self.shuffle:
+            random.Random(self.seed + self.epoch).shuffle(batches)
+        return iter(batches)
+
+
